{
    "experimental__visibility-layout#lp-garantia-carousel": {
        "title": "Visibilidade: Carrossel de serviços",
        "children": ["flex-layout.row#lp-garantia-carousel"]
    },

    "flex-layout.row#lp-garantia-carousel": {
        "title": "Carrossel de serviços",
        "children": ["editable-carousel#lp-garantia-carousel"],
        "props": {
            "blockClass": ["lp-garantia__carousel", "lp-garantia__section"]
        }
    },

